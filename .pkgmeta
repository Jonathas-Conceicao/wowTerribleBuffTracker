# RELEASE_NOTES.md is generated by GitHub Actions at release time
# (not committed to the repo). The release workflow writes it before
# BigWigs Packager runs, so the file's absence in the working tree is expected.
package-as: TerribleBuffTracker
manual-changelog:
  filename: RELEASE_NOTES.md
  markup-type: markdown

ignore:
  - .gitignore
  - .pkgmeta
  - CHANGELOG.md
  - CLAUDE.md
  - README.md
  - LICENSE
  - scripts
  - "*.png"
  - RELEASE_NOTES.md
