<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\Blizzard_SharedXML\UI.xsd">

	<Script file="CDMTab.lua"/>

	<!-- TBT tab button: inherits visual template but does NOT use parentArray
	     to avoid tainting CDM's secure TabButtons iteration.
	     The anchor below is a load-time placeholder only — CDMTab.lua re-anchors
	     the tab under the bottom-most Blizzard tab, whichever those turn out to be. -->
	<Frame name="TBTSettingsTab" parent="CooldownViewerSettings"
	       inherits="LargeSideTabButtonTemplate">
		<Size x="43" y="55"/>
		<Anchors>
			<Anchor point="TOP" relativeKey="$parent.AurasTab"
			        relativePoint="BOTTOM" x="0" y="-3"/>
		</Anchors>
	</Frame>

</Ui>
